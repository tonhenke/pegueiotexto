# ==========================================
# Peguei o Texto — Configurações do Backend
# ==========================================

# Groq API Key (Obtenha gratuitamente em https://console.groq.com)
# Whisper Large v3 gratuito com até 2.000 requisições/dia
GROQ_API_KEY=

# Stripe API Keys (Obtenha em https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# URL do Frontend Next.js
FRONTEND_URL=http://localhost:3000

# Diretório para armazenamento temporário de áudio antes da exclusão
TEMP_MEDIA_DIR=/tmp/peguei_o_texto_media
